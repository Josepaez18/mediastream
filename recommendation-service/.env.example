# Puerto HTTP (3001 User, 3002 Catalog, 3003 Playback, 3004 Media, 3005 Recommendation)
PORT=3005

# Base de datos propia (PostgreSQL + pgvector). Puerto 5437 en el host:
# 5433–5436 ya los usan Catalog, Playback, User y Media.
DATABASE_URL=postgresql+psycopg2://reco_user:reco_pass@localhost:5437/recommendation_db

# Redis Pub/Sub: aquí publica Playback-Service playback.progress / playback.completed
REDIS_URL=redis://localhost:6379
PROGRESS_CHANNEL=playback.progress
COMPLETED_CHANNEL=playback.completed

# Catalog-Service (REST): metadatos de los títulos para construir sus embeddings
CATALOG_SERVICE_URL=http://localhost:3002
CATALOG_TIMEOUT_SECONDS=2
CATALOG_RETRIES=2
CATALOG_SYNC_REGIONS=CO,MX,GLOBAL
CATALOG_SYNC_INTERVAL_SECONDS=60

# Peso del filtrado basado en contenido (α); el resto es colaborativo
CONTENT_WEIGHT=0.6
# Cuántos perfiles parecidos se consultan para el filtrado colaborativo
NEIGHBORS=10

CORS_ORIGINS=*
NODE_ENV=development

# --- Solo en Render (ver render.yaml y la guía de despliegue) ---------------
# Base propia de este servicio dentro de la instancia compartida de Render
# Postgres: reemplaza el nombre de la base al final de DATABASE_URL (y se crea
# sola al arrancar si no existe). En local no se usa.
# DATABASE_NAME=recommendation_db
# URLs públicas de los seis servicios (un dominio por servicio, sin puertos).
# La consola las lee en /config.js para enlazar los demás servicios y, si
# CORS_ORIGINS no está definida, son los únicos orígenes permitidos (sección 10).
# PUBLIC_USER_URL=https://mediastream-user.onrender.com
# PUBLIC_CATALOG_URL=https://mediastream-catalog.onrender.com
# PUBLIC_PLAYBACK_URL=https://mediastream-playback.onrender.com
# PUBLIC_MEDIA_URL=https://mediastream-media.onrender.com
# PUBLIC_RECOMMENDATION_URL=https://mediastream-recommendation.onrender.com
# PUBLIC_BILLING_URL=https://mediastream-billing.onrender.com
