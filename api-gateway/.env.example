# Copia este archivo a .env y ajusta los valores. Nunca commitees el .env real.

PORT=8080

# Mismo secreto con el que User-Service firma los AccessToken: el Gateway los
# valida sin consultarle (sección 10). Obligatorio en producción.
JWT_ACCESS_SECRET="dev-access-secret"

# URL de cada microservicio. Si falta, se usa PUBLIC_<SERVICIO>_URL y luego
# localhost con el puerto de desarrollo.
USER_SERVICE_URL="http://localhost:3001"
CATALOG_SERVICE_URL="http://localhost:3002"
PLAYBACK_SERVICE_URL="http://localhost:3003"
MEDIA_SERVICE_URL="http://localhost:3004"
RECOMMENDATION_SERVICE_URL="http://localhost:3005"
BILLING_SERVICE_URL="http://localhost:3006"
NOTIFICATION_SERVICE_URL="http://localhost:3007"
ANALYTICS_SERVICE_URL="http://localhost:3008"

# Tiempo máximo de espera de un microservicio antes de responder 504.
PROXY_TIMEOUT_MS=15000

# Rate limiting (solicitudes por minuto, por cuenta o por IP)
RATE_LIMIT_DEFAULT=120
RATE_LIMIT_READ=300
RATE_LIMIT_SENSITIVE=10
RATE_LIMIT_BILLING=20

# CORS: orígenes del frontend (separados por coma). "*" o vacío = cualquiera.
CORS_ORIGINS="*"
