# Copia este archivo a .env y ajusta los valores. Nunca commitees el .env real.

PORT=3007

# Redis: deduplicación + historial de notificaciones, y Pub/Sub de
# playback.completed (lo publica Playback-Service).
REDIS_URL="redis://localhost:6379"
COMPLETED_CHANNEL=playback.completed

# RabbitMQ: media.ready (exchange media.events) y payment.failed (exchange
# billing.events). Cada uno llega a una cola propia de este servicio.
RABBITMQ_URL="amqp://guest:guest@localhost:5672"

# Catalog-Service (REST, solo para poner el nombre del título en los avisos)
CATALOG_SERVICE_URL="http://localhost:3002"
CATALOG_TIMEOUT_MS=2000

# CORS - orígenes permitidos del frontend (separados por coma)
CORS_ORIGINS="*"

# --- Solo en Render (ver render.yaml) ----------------------------------------
# Sin CATALOG_SERVICE_URL se usa PUBLIC_CATALOG_URL; sin CORS_ORIGINS, solo se
# aceptan las URLs PUBLIC_*_URL de MediaStream.
# PUBLIC_CATALOG_URL=https://mediastream-catalog.onrender.com
