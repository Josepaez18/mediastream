# Puerto HTTP (3001–3007 ya los usan los demás servicios)
PORT=3008

# Base de datos PROPIA (tablas de KPIs). Puerto 5439 en el host.
DATABASE_URL=postgresql+psycopg2://analytics_user:analytics_pass@localhost:5439/analytics_db

# Réplicas de SOLO LECTURA de las que se alimenta el ETL. En desarrollo
# apuntan a las bases de Playback y Catalog: la conexión se abre en modo
# solo lectura (default_transaction_read_only), así que Analytics no puede
# modificar nada aunque sea la base original.
PLAYBACK_REPLICA_URL=postgresql+psycopg2://playback_user:playback_pass@localhost:5434/playback_db
CATALOG_REPLICA_URL=postgresql+psycopg2://catalog_user:catalog_pass@localhost:5433/catalog_db

# Cada cuánto se recalculan los KPIs
ETL_INTERVAL_SECONDS=300
ETL_INITIAL_DELAY_SECONDS=10

CORS_ORIGINS=*
NODE_ENV=development

# --- Solo en Render (ver render.yaml) ----------------------------------------
# Todas las bases viven en la misma instancia: basta con el nombre de cada una.
# DATABASE_NAME=analytics_db
# PLAYBACK_REPLICA_DATABASE_NAME=playback_db
# CATALOG_REPLICA_DATABASE_NAME=catalog_db
