# Copiar como .env y ajustar si es necesario. Nunca commitees el .env real.
# Puerto 5435 en el host: 5433 y 5434 ya los usan Catalog y Playback.
DATABASE_URL="postgresql://user_service:user_service@localhost:5435/user_service_db?schema=public"
RABBITMQ_URL="amqp://guest:guest@localhost:5672"
JWT_ACCESS_SECRET="dev-access-secret"
JWT_REFRESH_SECRET="dev-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
PORT=3001
NODE_ENV=development
CORS_ORIGINS="*"

# --- Solo en Render (ver render.yaml y la guía de despliegue) ---------------
# Base propia de este servicio dentro de la instancia compartida de Render
# Postgres: reemplaza el nombre de la base al final de DATABASE_URL (y se crea
# sola al arrancar si no existe). En local no se usa.
# DATABASE_NAME=user_service_db
# URLs públicas de los seis servicios (un dominio por servicio, sin puertos).
# La consola las lee en /config.js para enlazar los demás servicios y, si
# CORS_ORIGINS no está definida, son los únicos orígenes permitidos (sección 10).
# PUBLIC_USER_URL=https://mediastream-user.onrender.com
# PUBLIC_CATALOG_URL=https://mediastream-catalog.onrender.com
# PUBLIC_PLAYBACK_URL=https://mediastream-playback.onrender.com
# PUBLIC_MEDIA_URL=https://mediastream-media.onrender.com
# PUBLIC_RECOMMENDATION_URL=https://mediastream-recommendation.onrender.com
# PUBLIC_BILLING_URL=https://mediastream-billing.onrender.com
