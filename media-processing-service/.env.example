# Puerto HTTP del servicio (3001 User, 3002 Catalog, 3003 Playback, 3004 Media)
PORT=3004

# Base de datos propia de Media-Processing-Service (database-per-service).
# Puerto 5436 en el host: 5433-5435 ya los usan Catalog, Playback y User.
DATABASE_URL=postgresql+psycopg2://media_user:media_pass@localhost:5436/media_processing_db

# Message broker: publica media.ready / media.processing.failed.
# El exchange DEBE ser el mismo que escucha Catalog-Service.
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=media.events
MEDIA_READY_ROUTING_KEY=media.ready
MEDIA_FAILED_ROUTING_KEY=media.processing.failed

# Almacenamiento de objetos donde se suben los archivos maestro y los renditions
OBJECT_STORAGE_BUCKET=mediastream-media
OBJECT_STORAGE_ENDPOINT=https://storage.example.com
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# CDN que sirve los streams ya transcodificados
CDN_BASE_URL=https://cdn.mediastream.example.com

# Directorio temporal de trabajo para FFmpeg dentro del contenedor
WORK_DIR=/tmp/media-processing

# Orígenes permitidos para la consola web (coma-separado). "*" en desarrollo.
CORS_ORIGINS=*

NODE_ENV=development

# --- Solo en Render (ver render.yaml y la guía de despliegue) ---------------
# Base propia de este servicio dentro de la instancia compartida de Render
# Postgres: reemplaza el nombre de la base al final de DATABASE_URL (y se crea
# sola al arrancar si no existe). En local no se usa.
# DATABASE_NAME=media_processing_db
# URLs públicas de los seis servicios (un dominio por servicio, sin puertos).
# La consola las lee en /config.js para enlazar los demás servicios y, si
# CORS_ORIGINS no está definida, son los únicos orígenes permitidos (sección 10).
# PUBLIC_USER_URL=https://mediastream-user.onrender.com
# PUBLIC_CATALOG_URL=https://mediastream-catalog.onrender.com
# PUBLIC_PLAYBACK_URL=https://mediastream-playback.onrender.com
# PUBLIC_MEDIA_URL=https://mediastream-media.onrender.com
# PUBLIC_RECOMMENDATION_URL=https://mediastream-recommendation.onrender.com
# PUBLIC_BILLING_URL=https://mediastream-billing.onrender.com
