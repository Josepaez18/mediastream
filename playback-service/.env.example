# Copia este archivo a .env y ajusta los valores. Nunca commitees el .env real.

PORT=3003

# PostgreSQL (base de datos propia de Playback-Service, database-per-service)
DATABASE_URL="postgresql://playback_user:playback_pass@localhost:5434/playback_db?schema=public"

# Redis (cache de sesiones + Pub/Sub de playback.progress y playback.completed)
REDIS_URL="redis://localhost:6379"

# Catalog-Service (comunicación síncrona para validar disponibilidad regional)
CATALOG_SERVICE_URL="http://localhost:3002"
# Resiliencia (secciones 4.5–4.7 del documento):
# timeout por intento, reintentos con backoff exponencial y circuit breaker.
CATALOG_TIMEOUT_MS=2000
CATALOG_RETRIES=2
CATALOG_RETRY_BASE_MS=200
CATALOG_CB_FAILURE_THRESHOLD=3
CATALOG_CB_OPEN_MS=30000
# Caché corta de cada respuesta de Catalog y "última información conocida",
# que se usa para seguir emitiendo tokens mientras Catalog no responde.
CATALOG_CACHE_TTL_SECONDS=60
CATALOG_LAST_KNOWN_TTL_SECONDS=86400

# DRM simulado: clave de firma y duración del token de reproducción
DRM_JWT_SECRET="cambiar-esta-clave-en-produccion"
DRM_TOKEN_TTL_SECONDS=300

# Base del CDN que sirve los manifiestos HLS
CDN_BASE_URL="https://cdn.mediastream.local"

# CORS - orígenes permitidos del frontend (separados por coma)
CORS_ORIGINS="http://localhost:3000"

# --- Solo en Render (ver render.yaml y la guía de despliegue) ---------------
# Base propia de este servicio dentro de la instancia compartida de Render
# Postgres: reemplaza el nombre de la base al final de DATABASE_URL (y se crea
# sola al arrancar si no existe). En local no se usa.
# DATABASE_NAME=playback_db
# URLs públicas de los seis servicios (un dominio por servicio, sin puertos).
# La consola las lee en /config.js para enlazar los demás servicios y, si
# CORS_ORIGINS no está definida, son los únicos orígenes permitidos (sección 10).
# PUBLIC_USER_URL=https://mediastream-user.onrender.com
# PUBLIC_CATALOG_URL=https://mediastream-catalog.onrender.com
# PUBLIC_PLAYBACK_URL=https://mediastream-playback.onrender.com
# PUBLIC_MEDIA_URL=https://mediastream-media.onrender.com
# PUBLIC_RECOMMENDATION_URL=https://mediastream-recommendation.onrender.com
# PUBLIC_BILLING_URL=https://mediastream-billing.onrender.com
